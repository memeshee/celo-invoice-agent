# --- Telegram -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Who may /release and /drop a held invoice. Comma-separated Telegram user ids.
# Leave empty and nobody can release — the command fails closed.
OPERATOR_TELEGRAM_ID=

# --- Invoice parsing (Typesafe Jev) -------------------------------------------
# Either export TYPESAFE_API_KEY or leave unset to use ~/.config/typesafe/api_key
TYPESAFE_API_KEY=

# --- Celo ---------------------------------------------------------------------
CELO_RPC_URL=https://forno.celo.org
# Server-side only. Never commit. This wallet PAYS for services over x402.
AGENT_WALLET_KEY=
# Celo mainnet address payers send USA₮ to. Fallback for users who have not run
# /wallet. Any deployed instance must set it.
INVOICE_WALLET=
X402_FACILITATOR_URL=https://api.x402.celo.org
# ERC-8021 attribution code. A custom code tags transactions immediately; the code
# issued by a program must replace this before sending anything meant to count.
CELO_ATTRIBUTION_CODE=celo_b97cdbaae280
# ERC-8004 agent id, shown on the invoice pages.
ERC8004_AGENT_ID=

# --- Public invoice pages -----------------------------------------------------
# Base URL handed out in /pay and on mint. It must be the hostname that fronts
# bot/serve.py, or the link you send a payer will not open.
PUBLIC_BASE_URL=http://127.0.0.1:8088
PUBLIC_PORT=8088

# --- Background work ----------------------------------------------------------
WATCH_INTERVAL_S=45
# Set to 0 to stop the agent buying per-invoice services (FX cross-check +
# sanctions screens). Capped per loop so a burst of mints cannot drain the wallet.
SERVICES_ENRICH=1
ENRICH_MAX_PER_LOOP=3
