[Unit]
Description=impay — onchain settlement watcher
Documentation=https://github.com/memeshee/impay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/kiter/impay
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/kiter/impay/.venv/bin/python -m bot.watch
Restart=always
RestartSec=5
StartLimitIntervalSec=0
StandardOutput=append:/home/kiter/impay/watch.log
StandardError=append:/home/kiter/impay/watch.log

[Install]
WantedBy=default.target
