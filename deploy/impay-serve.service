[Unit]
Description=impay — public invoice pages
Documentation=https://github.com/memeshee/impay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/kiter/impay
Environment=PYTHONUNBUFFERED=1
Environment=PUBLIC_PORT=8088
ExecStart=/home/kiter/impay/.venv/bin/python -m bot.serve
Restart=always
RestartSec=3
StartLimitIntervalSec=0
StandardOutput=append:/home/kiter/impay/serve.log
StandardError=append:/home/kiter/impay/serve.log

[Install]
WantedBy=default.target
