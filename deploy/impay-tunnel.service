[Unit]
Description=impay — public HTTPS tunnel (Cloudflare quick tunnel)
Documentation=https://github.com/memeshee/impay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/kiter/impay
Environment=PYTHONUNBUFFERED=1
Environment=PUBLIC_PORT=8088
ExecStart=/usr/bin/env bash /home/kiter/impay/scripts/tunnel_sync.sh
Restart=always
RestartSec=5
StartLimitIntervalSec=0
StandardOutput=append:/home/kiter/impay/tunnel.log
StandardError=append:/home/kiter/impay/tunnel.log

[Install]
WantedBy=default.target
