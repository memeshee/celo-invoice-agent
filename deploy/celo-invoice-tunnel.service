[Unit]
Description=Celo Invoice Agent — public HTTPS tunnel (Cloudflare quick tunnel)
Documentation=https://github.com/memeshee/celo-invoice-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=<REPO>
Environment=PYTHONUNBUFFERED=1
Environment=PUBLIC_PORT=8088
ExecStart=/usr/bin/env bash <REPO>/scripts/tunnel_sync.sh
Restart=always
RestartSec=5
StartLimitIntervalSec=0
StandardOutput=append:<REPO>/tunnel.log
StandardError=append:<REPO>/tunnel.log

[Install]
WantedBy=default.target
